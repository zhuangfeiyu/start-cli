// 默认主题（浅色主题）
:root {
  // 主题色
  --theme: rgba(0, 71, 255, 1);
  --page-bg: #ffffff;
  --text-primary: #1f2937;
  --text-secondary: #4b5563;
  --text-disabled: #9ca3af;
  --white: #fff;
  --border-color: #e5e7eb;
  
  // 布局和主要区域背景
  --layout-bg: #f9fafb;
  --layout-main-bg: #ffffff;
  
  // 滚动条颜色
  --scrollbar-track: #f1f1f1;
  --scrollbar-thumb: #c1c1c1;
  --scrollbar-thumb-hover: #a8a8a8;
  
  // 登录页渐变背景
  --login-gradient-from: #667eea;
  --login-gradient-to: #764ba2;

  // 字体大小
  --font-s-20: 1.25rem;
  --font-s-18: 1.125rem;
  --font-s-16: 1rem;
  --font-s-14: 0.875rem;
  --font-s-12: 0.75rem;
  --font-s-10: 0.625rem;
}

<% if (needTheme) { -%>
// 深色主题
:root.dark {
  // 主题色
  --theme: rgba(59, 130, 246, 1);
  --page-bg: #0f172a;
  --text-primary: #f9fafb;
  --text-secondary: #d1d5db;
  --text-disabled: #6b7280;
  --white: #1f2937;
  --border-color: #374151;
  
  // 布局和主要区域背景
  --layout-bg: #0f172a;
  --layout-main-bg: #1e293b;
  
  // 滚动条颜色
  --scrollbar-track: #1e293b;
  --scrollbar-thumb: #475569;
  --scrollbar-thumb-hover: #64748b;
  
  // 登录页渐变背景（深色模式下可以保持或调整）
  --login-gradient-from: #4c1d95;
  --login-gradient-to: #5b21b6;
}
<% } -%>
