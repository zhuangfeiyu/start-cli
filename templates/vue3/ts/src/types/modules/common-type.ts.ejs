// 基础值类型
export type PrimitiveValue = string | number | boolean | undefined | null

// 选项类型
export type OptionItem = {
  value: string | number
  label: string
  [key: string]: PrimitiveValue | PrimitiveValue[] | OptionItem | OptionItem[]
}

