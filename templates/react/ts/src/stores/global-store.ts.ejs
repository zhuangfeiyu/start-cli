import { createSlice, type PayloadAction } from '@reduxjs/toolkit'
<% if (needInternational) { -%>
import { LANG_DEFAULT } from '@/constants/index'
import { setLocale } from '@/lang'
<% } -%>
<% if (needTheme) { -%>
import type { ThemeType } from '@/types/modules/common-type'
<% } -%>

export interface GlobalState {
<% if (needInternational) { -%>
  lang: string
<% } -%>
<% if (needTheme) { -%>
  theme: ThemeType
<% } -%>
}

const getInitialState = (): GlobalState =>
  ({
<% if (needInternational) { -%>
    lang: (localStorage.getItem('lang') as string) || LANG_DEFAULT,
<% } -%>
<% if (needTheme) { -%>
    theme: (localStorage.getItem('theme') as ThemeType) || 'light',
<% } -%>
  }) as GlobalState

<% if (needTheme) { -%>
function applyTheme(themeValue: ThemeType) {
  const root = document.documentElement
  root.classList.remove('dark')
  if (themeValue === 'dark') root.classList.add('dark')
}
<% } -%>

const globalSlice = createSlice({
  name: 'global',
  initialState: getInitialState(),
  reducers: {
<% if (needInternational) { -%>
    setLang: (state, action: PayloadAction<string>) => {
      state.lang = action.payload
      localStorage.setItem('lang', action.payload)
      setLocale(action.payload)
    },
<% } -%>
<% if (needTheme) { -%>
    setTheme: (state, action: PayloadAction<ThemeType>) => {
      state.theme = action.payload
      localStorage.setItem('theme', action.payload)
      applyTheme(action.payload)
    },
<% } -%>
<% if (!needInternational && !needTheme) { -%>
    _noop: (state) => state,
<% } -%>
  },
})

<% if (needTheme) { -%>
applyTheme(getInitialState().theme)
<% } -%>
<% if (needInternational) { -%>
setLocale(getInitialState().lang)
<% } -%>

<% if (needInternational) { -%>
export const setLang = globalSlice.actions.setLang
export const selectLang = (state: { global: GlobalState }) => state.global.lang
<% } -%>
<% if (needTheme) { -%>
export const setTheme = globalSlice.actions.setTheme
export const selectTheme = (state: { global: GlobalState }) => state.global.theme
<% } -%>

export default globalSlice.reducer
